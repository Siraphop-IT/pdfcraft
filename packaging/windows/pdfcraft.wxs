<?xml version="1.0" encoding="utf-8"?>
<!--
  PdfCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-user install into %LOCALAPPDATA%\Programs\BMU PDF, which needs no administrator, so the app
  can update itself from the office NAS (apps/pdfcraft/src/update.rs). A Start Menu shortcut, a desktop shortcut (on by default,
  optional, and an update keeps it only if it is still there), an App Paths entry, PdfCraft registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default), "Edit with PdfCraft" on PDF files'
  right-click menu and "Create PDF with PdfCraft…" on image files' right-click menu (both on by
  default, optional, and an update keeps the installed version's choice). Files opened with
  PdfCraft arrive on its command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="BMU PDF"
      Manufacturer="BMU"
      Version="$(var.Version)"
      UpgradeCode="3690BE8B-6E22-4D5E-8494-814572FBAD0B"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="BMU PDF" Manufacturer="BMU" />
    <!-- Every BMU PDF release before the self-updating ones installed for all users, into Program
         Files. A per-user copy would sit beside it (two Start menu entries, two Open with entries),
         and Windows Installer can't move one to the other, so an administrator removes the old
         copy first (packaging/windows/BMU-UPDATES.md); its Start menu key path tells it is there.
         Removing this copy is always possible. -->
    <Property Id="MACHINEBMUPDF">
      <RegistrySearch Id="MachineBmuPdfSearch" Root="HKLM" Key="Software\BMUPDF\Shortcuts" Name="StartMenu" Type="raw" />
    </Property>
    <Launch Condition="Installed OR NOT MACHINEBMUPDF"
        Message="BMU PDF is installed for all users on this computer. Ask an administrator to uninstall it in Settings &gt; Apps, then run this setup again: BMU PDF now installs for your account only and updates itself without an administrator." />
    <!-- The per-user folder. The Directory table names Program Files (so validation treats the
         files as the program's, not as profile data); this sets the real folder before costing,
         for installs, updates and removal alike. A folder given on the command line wins. -->
    <SetProperty Id="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\BMU PDF\" Before="CostFinalize" Sequence="both" Condition="NOT INSTALLFOLDER" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of BMU PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/pdfcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/pdfcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the app
         updates itself with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="BMU PDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- The File Explorer menus: "Edit with PdfCraft" for PDF files (#682) and "Create PDF with
         PdfCraft…" for images (#190). Each is on by default for a first install and has a property
         to leave it out of unattended installs: INSTALLPDFCONTEXTMENU=0 (also a welcome-dialog
         checkbox) and INSTALLIMAGECONTEXTMENU=0. Secure, like the desktop shortcut's.
         An update keeps the installed version's choice (#305) by looking for the menu's registry
         key, the way the desktop shortcut looks for its file: AppSearch runs before the old version
         is removed. Releases from before a menu existed (the PDF one came in 0.7.1, the image one in
         0.4.0) never had the key, so updating from one of them counts as a first install; the
         OnlyDetect rows below tell them apart. A value given on the command line wins. -->
    <Upgrade Id="3690BE8B-6E22-4D5E-8494-814572FBAD0B">
      <UpgradeVersion Minimum="0.7.1" IncludeMinimum="yes" OnlyDetect="yes" Property="PDFCONTEXTMENURELEASE" />
      <UpgradeVersion Minimum="0.4.0" IncludeMinimum="yes" OnlyDetect="yes" Property="IMAGECONTEXTMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU">
      <RegistrySearch Id="PdfContextMenuSearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Edit" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT PDFCONTEXTMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU">
      <RegistrySearch Id="ImageContextMenuSearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.CreatePdf" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT IMAGECONTEXTMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="BMU PDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="BMU PDF" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="PdfcraftFiles" />
      <ComponentGroupRef Id="PdfcraftModels" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="CEB5EB1A-4A56-4A16-9B5E-DA806CDD9783">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\pdfcraft.exe" KeyPath="yes" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pdfcraft.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): PdfCraft is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             PdfCraft entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\BMUPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\BMUPDF.Document\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\BMUPDF.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- No overlay on thumbnails and in the preview pane: without TypeOverlay, Windows paints
             the default program's icon (the lion) over the lower-right corner of every PDF
             thumbnail, covering part of the page. An empty string means none ("Thumbnail
             Handlers", Microsoft Learn). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\BMUPDF.Document" Name="TypeOverlay" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="BMUPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe" Name="FriendlyAppName" Value="BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Capabilities" Name="ApplicationName" Value="BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Capabilities\FileAssociations" Name=".pdf" Value="BMUPDF.Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="BMU PDF" Value="Software\BMUPDF\Capabilities" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to pdfcraft.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with a registry key path (HKMU, which is the user's
           in this per-user package), so Windows Installer removes it on uninstall; both folders
           are the user's own. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="01407DE7-99A2-4F3A-8603-154BB9CCDBA4">
        <Shortcut Id="StartMenuShortcut" Name="BMU PDF" Description="BMU PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="685344DC-BEE3-4068-AB4D-D2F3EBCDA98B"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="BMU PDF" Description="BMU PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\BMUPDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with PdfCraft" opens the file in PdfCraft whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with a registry key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="PdfcraftPdfContextMenu" Guid="5C8A23A5-681B-4CD1-8D7F-EC886E6B01EA"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Edit" Value="Edit with BMU PDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Edit" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Edit\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- "Combine files in BMU PDF" (upstream #585, PR #2541): Explorer starts one process per
             selected file; each hands its file to the first, and they all join one Combine files list. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Image context menu (#190): "Create PDF with PdfCraft…" opens the DPI chooser, without
           changing image file defaults. Its own component with a registry key path, so
           INSTALLIMAGECONTEXTMENU=0 leaves it out and uninstall removes it. These rows were in
           PdfcraftApp up to 0.7.1; moving them is safe because MajorUpgrade removes the old version
           before installing (afterInstallValidate), so no old row is left behind. -->
      <Component Id="PdfcraftImageContextMenu" Guid="284DF748-087F-4005-8B54-D9BD0D0451A2"
          Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.CreatePdf" Value="Create PDF with BMU PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <!-- "Combine files in BMU PDF" on the same pictures: they join the Combine files list with
             any PDFs selected beside them, made into PDFs as they join. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.Combine" Value="Combine files in BMU PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BMUPDF.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\pdfcraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="PdfcraftDocumentIconLicense">
        <File Id="PdfcraftDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftMitLicense">
        <File Id="PdfcraftMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftApacheLicense">
        <File Id="PdfcraftApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftNotice">
        <File Id="PdfcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside pdfcraft.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="PdfcraftModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
